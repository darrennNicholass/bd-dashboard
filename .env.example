# Template konfigurasi. AMAN di-commit karena tidak berisi nilai asli.
# Salin menjadi .env lalu isi dengan URL yang sesuai.

# Active ESSM (sumber Market Research) - spreadsheet asli
ACTIVE_ESSM_URL=

# National MIRROR - satu-satunya sumber data National yang diizinkan.
# JANGAN mengisi ini dengan URL National ESSM asli.
NATIONAL_SOURCE_URL=

# S&D Fulfillment Tracker (read-only Drive access)
GOOGLE_SERVICE_ACCOUNT=
SND_FOLDER_ID=
# Required for Streamlit Community Cloud; there is no automatic local fallback.
# The service account's Google Cloud project must have the Google Sheets API
# ENABLED. Sharing the sheet is not enough: every call returns 403
# SERVICE_DISABLED while it is off. Verify with:
#   python -m src.snd_backup preflight --sheet-id "<ID or URL>"
SND_STORAGE_BACKEND=google_sheets
# Separate writable spreadsheet ID (not the Drive folder ID or ESSM source).
# Share only this config sheet with the service account as Editor.
SND_CONFIG_SHEET_ID=
# Set only after the cutover command reports ready_for_production_switch=true.
SND_CUTOVER_ID=
# Local development or a server with a persistent disk ONLY:
# SND_STORAGE_BACKEND=sqlite, unset SND_CONFIG_SHEET_ID, and specify an ABSOLUTE path.
SND_DB_PATH=
